# Copy to .env and fill in. Never commit .env.
PORT=3000
# Local MongoDB, or your MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/discharge
# Long random string, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d
# Comma-separated list of allowed browser origins (add your Vercel URL in production)
CLIENT_ORIGIN=http://localhost:5173
# Missed-dose sweep: every 15 minutes; a dose is missed 120 minutes after its time
CRON_SCHEDULE=*/15 * * * *
DOSE_GRACE_MINUTES=120
# Adds POST /api/dev/run-sweep so the demo doesn't depend on the cron timer
ENABLE_DEMO_TOOLS=true
